# ClaimOS environment template.
# Do not copy by hand: run `python scripts/dev_setup.py`, which writes .env with generated secrets.
# Values containing "change_me" are rejected when APP_ENV=production.

APP_ENV=development
APP_BASE_URL=http://localhost:8080
LOG_LEVEL=INFO

# Host ports (bound to 127.0.0.1 only, except HTTP_PORT)
HTTP_PORT=8080
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380
S3_HOST_PORT=8333

# PostgreSQL: migrator owns the schema, claimos_app is the least-privileged runtime role
POSTGRES_PASSWORD=change_me_migrator
CLAIMOS_APP_DB_PASSWORD=change_me_app

REDIS_PASSWORD=change_me_redis

# S3-compatible object storage (SeaweedFS in development)
S3_ACCESS_KEY_ID=change_me_access_key
S3_SECRET_ACCESS_KEY=change_me_secret_key
# AES256 | aws:kms | none   (none is reported as a development adapter and refused in production)
S3_SERVER_SIDE_ENCRYPTION=AES256
# Hex key-encryption key for SeaweedFS SSE-S3 (development storage only)
S3_SSE_KEK=change_me_kek

# --- AI (Phase 5) -------------------------------------------------------------
# Never commit a real key. Free endpoints may log prompts: use synthetic data only.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=openrouter/free
OPENROUTER_VISION_MODEL=
OPENROUTER_REASONING_MODEL=
OPENROUTER_FAST_MODEL=
